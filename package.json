{
  "name": "visor-system-monitor",
  "private": true,
  "version": "0.9.5-beta.1",
  "description": "Premium local-first system and AI workload monitor for Windows, macOS, and Linux",
  "author": "Benz Engineering",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Benz-On/visor.git"
  },
  "bugs": {
    "url": "https://github.com/Benz-On/visor/issues"
  },
  "homepage": "https://github.com/Benz-On/visor#readme",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "agent": "node agent/server.mjs",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "desktop:build:debug": "tauri build --debug --no-bundle",
    "bundle:windows": "tauri build --bundles nsis",
    "bundle:macos": "tauri build --bundles app,dmg",
    "bundle:linux": "tauri build --bundles appimage,deb",
    "release:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "smoke:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-windows-portable.ps1",
    "check:workflows": "node scripts/check-workflow-pins.mjs",
    "test:agent": "node --test tests/*.test.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "systeminformation": "^5.33.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.5"
  }
}
